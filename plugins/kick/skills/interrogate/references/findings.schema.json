{
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment", "summary", "residual_risks", "findings"],
  "properties": {
    "assessment": {
      "type": "string",
      "enum": ["no_material_issues", "material_issues", "insufficient_context"]
    },
    "summary": { "type": "string" },
    "residual_risks": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "confidence",
          "category",
          "file",
          "line",
          "problem",
          "why_it_matters",
          "scenario",
          "suggestion"
        ],
        "properties": {
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "invariants",
              "failure_modes",
              "concurrency",
              "data_integrity",
              "contracts",
              "security",
              "performance",
              "operability",
              "design",
              "tests",
              "house_rule"
            ]
          },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "problem": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "scenario": { "type": "string" },
          "suggestion": { "type": ["string", "null"] }
        }
      }
    }
  }
}
